{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "color-no-hex": true,
    "declaration-no-important": true,
    "no-descending-specificity": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "layer",
          "container"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "assets/src/css/layers/tokens.css"
      ],
      "rules": {
        "color-no-hex": null
      }
    },
    {
      "files": [
        "assets/src/css/pages/blog.css",
        "assets/src/css/pages/cart-port.css",
        "assets/src/css/pages/quote.css",
        "assets/src/css/layers/base.css",
        "assets/src/css/layers/components/calculators-tables.css"
      ],
      "rules": {
        "no-duplicate-selectors": null
      }
    }
  ]
}
