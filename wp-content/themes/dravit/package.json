{
  "name": "dravit-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:tokens": "node tools/build-tokens.mjs",
    "build": "node tools/build-tokens.mjs && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "eslint \"assets/src/js/**/*.js\" \"tests/js/**/*.js\"",
    "lint:css": "stylelint \"assets/src/css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.29.2",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "animejs": "^3.2.2"
  }
}
