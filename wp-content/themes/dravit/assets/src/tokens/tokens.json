{
  "colors": {
    "brand-primary": "#083A4F",
    "navy-950": "#052330",
    "navy-900": "#083A4F",
    "navy-800": "#1E3A5F",
    "navy-700": "#2A4D68",
    "navy-600": "#386172",
    "navy-500": "#64748B",
    "navy-400": "#94A3B8",
    "navy-300": "#CBD5E1",
    "navy-200": "#E2E8F0",
    "navy-100": "#E2E8F0",
    "navy-hover": "#0B4A64",
    "text-main": "#0B192C",
    "text-muted": "#1E3A5F",
    "teal-800": "#115E59",
    "teal-700": "#0F766E",
    "teal-600": "#0D9488",
    "teal-500": "#0D9488",
    "teal-300": "#5EEAD4",
    "teal-100": "#CCFBF1",
    "teal-50": "#F0FDFA",
    "amber-800": "#92400E",
    "amber-600": "#D97706",
    "amber-500": "#F59E0B",
    "amber-100": "#FEF3C7",
    "champagne": "#F1F5F9",
    "ivory": "#F8FAFC",
    "white": "#FFFFFF",
    "sale": "#E11D48",
    "sale-bg": "#FFE4E6",
    "brand-sale": "#C0392B",
    "success": "#059669",
    "success-bg": "#ECFDF5",
    "warning": "#D97706",
    "warning-bg": "#FFFBEB"
  },
  "colorAliases": {
    "moss-700": "var(--c-teal-700)",
    "moss-600": "var(--c-teal-600)",
    "moss-500": "var(--c-teal-500)",
    "moss-100": "var(--c-teal-100)",
    "navy": "var(--c-navy-900)",
    "sand-50": "var(--c-ivory)",
    "coral-600": "var(--c-sale)",
    "bg-page": "var(--c-ivory)",
    "backdrop": "rgb(8 58 79 / 60%)"
  },
  "fonts": {
    "display": "\"Anton\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "body": "\"Quicksand\", \"Quicksand Fallback\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, \"Cascadia Code\", \"Source Code Pro\", monospace"
  },
  "fontSizes": {
    "display": "clamp(2.25rem, 1.6rem + 2.8vw, 4rem)",
    "h1": "clamp(1.875rem, 1.4rem + 2vw, 3rem)",
    "h2": "clamp(1.5rem, 1.25rem + 1vw, 2rem)",
    "xl": "1.5rem",
    "h3": "1.25rem",
    "lg": "1.125rem",
    "md": "1rem",
    "base": "1rem",
    "sm": "0.875rem",
    "xs": "0.75rem",
    "price": "clamp(1.5rem, 1.3rem + 0.8vw, 2rem)"
  },
  "lineHeights": {
    "display": "1.06",
    "tight": "1.15",
    "snug": "1.3",
    "base": "1.6"
  },
  "spacing": {
    "1": "0.25rem",
    "1-5": "0.375rem",
    "2": "0.5rem",
    "2-5": "0.625rem",
    "3": "0.75rem",
    "3-5": "0.875rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem"
  },
  "layout": {
    "container-max": "1380px",
    "container-pad": "var(--s-4)",
    "grid-gap": "var(--s-4)",
    "sec-pad-y": "var(--s-7)",
    "header-top-h": "68px",
    "header-top-h-compact": "56px",
    "header-nav-h": "44px",
    "header-h-desktop": "calc(var(--header-top-h) + var(--header-nav-h))",
    "header-h-current": "var(--header-top-h)",
    "mobile-bar-h": "56px"
  },
  "radii": {
    "2xs": "2px",
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "borders": {
    "bw": "1px solid var(--c-navy-200)",
    "bw-input": "1px solid var(--c-navy-400)",
    "bw-strong": "1px solid var(--c-navy-900)"
  },
  "shadows": {
    "sh-sm": "0 2px 8px rgb(8 58 79 / 5%)",
    "shadow-sm": "var(--sh-sm)",
    "shadow-card": "var(--sh-sm)",
    "shadow-hover": "0 6px 20px rgb(11 25 44 / 8%)",
    "shadow-dropdown": "0 12px 32px rgb(11 25 44 / 12%)",
    "focus-ring": "2px solid var(--c-teal-500)"
  },
  "zIndex": {
    "sticky": "20",
    "dropdown": "30",
    "header": "40",
    "modal": "60",
    "toast": "70"
  },
  "motion": {
    "dur-instant": "100ms",
    "dur-fast": "160ms",
    "dur-base": "260ms",
    "dur-drawer": "280ms",
    "dur-slow": "420ms",
    "ease-out": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "t-fast": "var(--dur-fast) var(--ease-out)"
  }
}
