parameters:
    level: 6
    paths:
        - functions.php
        - inc
        - config
    bootstrapFiles:
        - tests/php/phpstan-bootstrap.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    scanFiles:
        - inc/Core/Helpers.php
    treatPhpDocTypesAsCertain: false
